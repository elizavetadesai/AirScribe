# Copy to .env (never commit .env). All optional for local development.

# Long random string. Without it, logins reset on every server restart.
JWT_SECRET=change-me-to-a-long-random-string
TOKEN_HOURS=12

# SQLite file by default. On Render/HF Spaces the disk is wiped on restart,
# so use a free Postgres (e.g. Neon or Render Postgres) for the deployed app:
# DATABASE_URL=postgresql://user:password@host/dbname
DATABASE_URL=

# Frontend origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
# Optional: allow Vercel preview URLs too
# CORS_ORIGIN_REGEX=https://airscribe-.*\.vercel\.app

# Folder with airscribe.onnx and airscribe_meta.json
MODEL_DIR=models

# Data collection uploads from the /collect page.
# Share the collect link as https://<frontend>/collect?code=<COLLECT_CODE>
COLLECT_CODE=pick-a-short-team-code
# Long random secret for /collect/summary and /collect/export (never share it)
COLLECT_ADMIN_KEY=
